# Copy to .env.local for local dev. For CI/prod use GitHub Secrets or AWS Secrets Manager (see SETUP.md).

# Database (Neon or local: postgresql://synta:synta@localhost:5432/synta with docker-compose)
DATABASE_URL=your_neon_database_url_here

# NextAuth (use your public URL in production, e.g. https://your-app.example.com)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32
# Set AUTH_TRUST_HOST=true when running in Docker or behind a proxy (Auth.js v5)

# OAuth Providers
# Google OAuth
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# GitHub OAuth
AUTH_GITHUB_ID=your_github_client_id_here
AUTH_GITHUB_SECRET=your_github_client_secret_here

# Groq AI (Llama 3.1 8B – free tier at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_api_key_here
